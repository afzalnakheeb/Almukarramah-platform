d.\u003c\/p\u003e\n\n    \u003ch3\u003ePerfect for Gifting\u003c\/h3\u003e\n    \u003cp\u003eThe Al Kareem Mushaf Holder also makes an excellent gift for various occasions such as weddings, Eid celebrations, or housewarming parties. Gifting this beautiful holder allows others to elevate their prayer experience, and it's perfect for anyone who values both beauty and practicality in their home decor. This thoughtful gift is sure to be appreciated by anyone who receives it, fostering a deeper connection with the Quran.\u003c\/p\u003e\n  \u003c\/div\u003e\n\n  \u003cbutton class=\"read-more-toggle\" onclick=\"toggleReadMoreMushafHolder()\"\u003eRead more\u003c\/button\u003e\n\u003c\/div\u003e\n\n\u003cscript\u003e\nfunction toggleReadMoreMushafHolder() {\n  const container = document.getElementById('alKareemMushafHolderDesc');\n  const button = container.nextElementSibling;\n\n  container.classList.toggle('expanded');\n  button.innerText = container.classList.contains('expanded')\n    ? 'Read less'\n    : 'Read more';\n}\n\u003c\/script\u003e","vendor":"Kashida Design","product_type":"Quran holders","created_at":"2022-04-05T12:00:08+04:00","handle":"al-kareem-mushaf-holder-silver","updated_at":"2026-11-05T13:08:45+04:00","published_at":"2022-04-05T12:00:11+04:00","template_suffix":"tt-decor-all","published_scope":"web","tags":"Al Kareem, Home Accessories, Islamic Decor, Mushaf Holder, Quran Stand, returns, same day delivery","variants":[{"id":42716820144356,"product_id":7611144044772,"title":"Default Title","price":"325.00","sku":"ALKMH-SI","position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":"shopify","option1":"Default Title","option2":null,"option3":null,"created_at":"2022-04-05T12:00:08+04:00","updated_at":"2026-11-05T13:08:45+04:00","taxable":true,"barcode":"0619091925866","grams":1500,"image_id":null,"weight":1.5,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"AED"