{
  "name": "almukarramah-platform",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:web": "node scripts/build-catalogue.mjs && node scripts/build-intro.mjs && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "vercel-install": "npm install --legacy-peer-deps && npx expo install --fix -- --legacy-peer-deps",
    "icons": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "*",
    "@expo-google-fonts/cormorant-garamond": "*",
    "@expo-google-fonts/manrope": "*",
    "@expo-google-fonts/readex-pro": "*",
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2",
    "expo": "~57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "*",
    "react-native-web": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "sharp": "^0.33.5",
    "typescript": "~6.0.3"
  }
}
