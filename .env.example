# Copy to .env and fill in. Values starting EXPO_PUBLIC_ are visible in the app; never put secrets there.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-side secrets: set these in Supabase (Project settings > Edge Functions > Secrets), not in the app.
# MOYASAR_SECRET_KEY=sk_test_...
# MOYASAR_WEBHOOK_SECRET=a-long-random-string
# ANTHROPIC_API_KEY=sk-ant-...
# REVENUECAT_WEBHOOK_AUTH=a-long-random-string
# QF_CLIENT_ID=...
# QF_CLIENT_SECRET=...
# PUBLIC_SITE_URL=https://almukarramah.com
