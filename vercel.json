{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run vercel-install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "shots/**": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "almukarramah-platform.vercel.app"
        }
      ],
      "destination": "https://almukarramah.com/:path*",
      "permanent": false
    },
    {
      "source": "/trail/quran-trail",
      "destination": "/apps/recite-with-me",
      "permanent": false
    },
    {
      "source": "/trail/seerah-trail",
      "destination": "/apps/seerah-trails",
      "permanent": false
    },
    {
      "source": "/products/:slug([^./]+)",
      "destination": "/product/:slug",
      "permanent": true
    },
    {
      "source": "/collections/:c/products/:slug([^./]+)",
      "destination": "/product/:slug",
      "permanent": true
    },
    {
      "source": "/collections/all",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/collections",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/pages/:page*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/account/:path+",
      "destination": "/account",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|decks/).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(products|images|films)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/decks",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/decks/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    }
  ]
}
